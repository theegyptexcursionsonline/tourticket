{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "tsx scripts/dev-with-port.ts",
    "dev:port": "tsx scripts/dev-with-port.ts -p",
    "dev:original": "next dev --turbopack",
    "prebuild": "if [ \"$SKIP_TESTS\" = \"1\" ]; then echo '⏭️  SKIP_TESTS=1 — skipping pre-build checks'; else echo '🧪 Running pre-build checks...' && NODE_ENV=test pnpm test:unit && echo '✅ All pre-build checks passed!'; fi",
    "build": "next build",
    "build:skip-tests": "SKIP_TESTS=1 next build",
    "type": "next typegen",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "test": "pnpm test:unit && printf '\\nNote: the server-dependent API suite (__tests__/api/supertest.test.ts) is NOT part of this run.\\nIt needs a live app on TEST_BASE_URL (default http://localhost:3000) — run it with: pnpm test:api\\n\\n'",
    "test:unit": "jest --passWithNoTests --testPathIgnorePatterns='/e2e/' --testPathIgnorePatterns='supertest' --testPathIgnorePatterns='/.claude/'",
    "test:api": "jest --testPathPatterns='supertest'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui": "env -u NO_COLOR playwright test --ui",
    "test:e2e:report": "env -u NO_COLOR playwright show-report",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && pnpm test:e2e",
    "blog:migrate-tenant-index": "tsx scripts/migrate-blog-slug-tenant-index.ts",
    "algolia:sync": "tsx scripts/sync-algolia.ts",
    "algolia:clear-sync": "tsx scripts/sync-algolia.ts --clear",
    "algolia:sync-all": "tsx scripts/sync-all-algolia.ts",
    "revenue:backfill-pricing": "tsx scripts/backfill-revenue-pricing.ts",
    "revenue:verify-migration": "tsx scripts/verify-revenue-pricing-migration.ts",
    "revenue:verify-e2e": "tsx scripts/verify-revenue-pricing-e2e.ts",
    "revenue:verify-production": "tsx scripts/verify-revenue-production.ts",
    "bookings:verify-payment-index": "tsx scripts/sync-booking-index.ts",
    "checkout:verify-inventory": "tsx scripts/verify-checkout-inventory.ts",
    "bookings:verify-refunds": "tsx scripts/verify-booking-refunds.ts",
    "theme:generate": "tsx scripts/generate-dark-theme-css.ts",
    "theme:check": "tsx scripts/generate-dark-theme-css.ts --check"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.23",
    "@algolia/client-search": "^5.55.2",
    "@intercom/messenger-js-sdk": "^0.0.18",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/nextjs": "^10.65.0",
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "ai": "^7.0.22",
    "algoliasearch": "^5.55.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "currency.js": "^2.0.4",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "form-data": "^4.0.6",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "handlebars": "^4.7.9",
    "instantsearch.css": "^8.18.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.542.0",
    "mailgun.js": "^12.9.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.1",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-intl": "^4.13.2",
    "openai": "^6.46.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-instantsearch": "^7.39.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.9.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^18.5.0",
    "styled-jsx": "5.1.6",
    "swiper": "^12.2.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss-rtl": "^0.9.0",
    "webpack": "5.104.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "detect-port": "^2.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.17",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4",
      "dompurify": "3.4.13",
      "fast-uri": "3.1.5",
      "fast-xml-parser": "5.7.0",
      "minimatch@>=10.2.0>brace-expansion": "5.0.9",
      "nanoid": "3.3.17",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "sharp": "0.35.3",
      "uuid": "11.1.1",
      "webpack": "5.104.1",
      "yaml": "2.8.3"
    }
  }
}
