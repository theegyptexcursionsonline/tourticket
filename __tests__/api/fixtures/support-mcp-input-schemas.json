{
  "verify_booking_identity": {
    "type": "object",
    "properties": {
      "reference": {
        "type": "string",
        "minLength": 12,
        "maxLength": 80
      },
      "proofType": {
        "type": "string",
        "enum": [
          "provider_phone",
          "verified_email"
        ]
      },
      "proofValue": {
        "type": "string",
        "minLength": 3,
        "maxLength": 254
      },
      "verificationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{7,159}$"
      },
      "binding": {
        "type": "object",
        "properties": {
          "workspaceKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"
          },
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "channel": {
            "type": "string",
            "enum": [
              "widget",
              "whatsapp"
            ]
          }
        },
        "required": [
          "workspaceKey",
          "conversationId",
          "channel"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "reference",
      "proofType",
      "proofValue",
      "verificationId",
      "binding"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
