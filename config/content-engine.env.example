# Empty values are intentional: set secrets only in the provider secret store.
CONTENT_ENGINE_API_KEY=
CONTENT_ENGINE_API_KEY_NEXT=
CONTENT_ENGINE_ALLOWED_TENANTS=default
CONTENT_ENGINE_RECEIVER_GRANTS_JSON={"version":2,"grants":[{"id":"primary","secretEnv":"CONTENT_ENGINE_API_KEY","targets":[{"method":"POST","receiverType":"blog","tenantId":"default","locale":"en"},{"method":"PUT","receiverType":"blog","tenantId":"default","locale":"en"},{"method":"POST","receiverType":"destination","tenantId":"default","locale":"en"},{"method":"POST","receiverType":"category","tenantId":"default","locale":"en"},{"method":"PUT","receiverType":"category","tenantId":"default","locale":"en"}]}]}
# Draft-only acceptance (separate named credential; no public publication):
# Version 3 requires publicationMode on every target and canonical expiresAt on every grant.
# The example expiry is deliberately past; select a reviewed absolute deadline once.
# Old deployments retaining the key reject it at expiry; this is not immediate revocation.
# Draft mode supports blog POST and archive PATCH only; PUT and other types fail closed. Keep the grant
# absent until the exact receiver target and cleanup flow have been admitted.
# CONTENT_ENGINE_RECEIVER_GRANTS_JSON={"version":3,"grants":[{"id":"draft-review","expiresAt":"2000-01-01T00:00:00.000Z","secretEnv":"CONTENT_ENGINE_API_KEY_NEXT","targets":[{"method":"POST","receiverType":"blog","tenantId":"default","locale":"en","publicationMode":"draft"},{"method":"PATCH","receiverType":"blog","tenantId":"default","locale":"en","publicationMode":"draft"}]}]}
